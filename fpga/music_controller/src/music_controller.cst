// W6 result/control link only: module TXD -> FPGA RX,3.3V digital levels.
IO_LOC "uart_rx" AA19;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "uart_tx" AA20;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "bt_state" AB21;
IO_PORT "bt_state" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;

// SUG1018 section2.8: GW5A(T)-60 DCE supports primary PG placement.
// M04 SG[3] enable net is3.914ns; choose primary clock gating resources.
// This changes placement only. All IO and SDC setup/hold checks are retained.
INS_LOC "transport/pixel_gate" PG;

IO_LOC "vel_rx" T21;
IO_PORT "vel_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "vel_tx" P19;
IO_PORT "vel_tx" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;

// V23 R01 proved old generated title_311_6 no longer exists after UI changes.
// Remove that obsolete route hint only; all actual pins and SDC stay unchanged.

IO_LOC "i2s_bck" T18;
IO_PORT "i2s_bck" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;

IO_LOC "i2s_lrck" R18;
IO_PORT "i2s_lrck" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;

IO_LOC "i2s_din" R17;
IO_PORT "i2s_din" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;

// R06: SUG1018 section2.7, explicit global routing for reset/set sinks.
// No clock number is guessed; verify actual allocation in the physical report.
// Reset timing, RTL and every existing SDC requirement remain unchanged.
CLOCK_LOC "audio_rst" BUFG = SR;

// Inherited score reset policy retained; all SDC timing requirements unchanged.
CLOCK_LOC "system/platform/audio/bank/scoring_frontend.scoring/engine/n640_6" BUFG = SR;
// R12 verified DD reset exclusion from globals but gave751unrouted vs750.
// Retire that routing experiment. No DD-specific generated-name hint remains;
// actual DD reset roles and vendor automatic allocation are audited separately.

// GS2: Primer20K T6 TX -> NEO PMOD0 P16 (official J9.7).
IO_LOC "gesture_rx" P16;
IO_PORT "gesture_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;


// Candidate: explicit route for the verified PCM sample enable and logic consumers.
// SUG1018-1.7 section2.7; no frequency, pin or SDC exception change.
CLOCK_LOC "pcm_sample_ce" BUFG = CE|LOGIC;

// Official btn_n1 / Silicone Key_1, T3, external 1.5V pullup.
// Locate by Dock underside T3; schematic component S2 is not the user key number.
IO_LOC "capture_n" T3;
IO_PORT "capture_n" IO_TYPE=LVCMOS15 PULL_MODE=NONE BANK_VCCIO=1.5;

// Additional official Dock keys; no camera wiring changes.
IO_LOC "size_n" T10;
IO_PORT "size_n" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "position_n" T2;
IO_PORT "position_n" IO_TYPE=LVCMOS15 PULL_MODE=NONE BANK_VCCIO=1.5;

// GS2 sustain TX: Primer20K Dock PMOD0, silk T6; no60K connection until its pin audit.
IO_LOC "gesture_tx" T6;
IO_PORT "gesture_tx" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=4 BANK_VCCIO=3.3;
